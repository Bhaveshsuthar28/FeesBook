PORT=8000
DATABASE_URL=
DATABASE_AUTH_TOKEN=
BASE_URL=http://localhost:5173

CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=

IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=

# Frontend (create Frontend/.env from Frontend/.env.example)
# VITE_BASE_URL=http://localhost:8000/api/v1

# ─── Redis ────────────────────────────────────────────────────────────────────
# Cache Redis (Upstash recommended — set eviction policy to allkeys-lru)
# Used for: school profile cache, dashboard cache, fee type cache
CACHE_REDIS_URL=rediss://:your_password@your-upstash-cache-endpoint:6380

# Queue Redis (Upstash recommended — set eviction policy to noeviction)
# Used for: Bull job queues (WhatsApp reminders, receipts)
# IMPORTANT: Must use noeviction policy — jobs must never be silently dropped
QUEUE_REDIS_URL=rediss://:your_password@your-upstash-queue-endpoint:6380

# Legacy fallback (kept for backward compatibility, prefer QUEUE_REDIS_URL above)
REDIS_URL=

# Set to "true" during local testing to log bot replies to console
# instead of calling the real Meta WhatsApp API
WHATSAPP_DRY_RUN=false
